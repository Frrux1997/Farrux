<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Logo AI Studio Enterprise</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        :root {
            --bg-color: #0d0d12;
            --panel-bg: #151522;
            --accent-color: #00FF7F;
            --text-color: #ffffff;
            --border-color: #26263b;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        h2 {
            color: var(--accent-color);
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 20px;
            margin-bottom: 20px;
            text-shadow: 0 0 15px rgba(0, 255, 127, 0.3);
        }

        .form-panel {
            width: 100%;
            max-width: 360px;
            background: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 20px;
            box-sizing: border-box;
            box-shadow: 0 8px 32px rgba(0,0,0,0.5);
        }

        .form-group {
            margin-bottom: 18px;
        }

        label {
            display: block;
            font-size: 11px;
            color: #888;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        input, select {
            width: 100%;
            padding: 12px;
            background: #1e1e2f;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: #fff;
            font-size: 14px;
            box-sizing: border-box;
            transition: 0.3s;
        }

        input:focus, select:focus {
            border-color: var(--accent-color);
            outline: none;
        }

        .color-palette {
            display: flex;
            gap: 10px;
            margin-top: 5px;
        }
        .color-box {
            flex: 1;
            height: 40px;
            border-radius: 6px;
            cursor: pointer;
            border: 2px solid transparent;
            transition: 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: bold;
        }
        .color-box.selected {
            border-color: var(--accent-color);
            transform: scale(1.05);
        }

        .action-btn {
            width: 100%;
            max-width: 360px;
            padding: 15px;
            background: linear-gradient(90deg, #00FF7F, #00D26A);
            border: none;
            border-radius: 10px;
            color: #050505;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 20px;
            box-shadow: 0 4px 20px rgba(0, 255, 127, 0.3);
            transition: 0.2s;
        }

        .action-btn:active {
            transform: scale(0.98);
        }

        .loader {
            display: none;
            margin-top: 20px;
            width: 100%;
            max-width: 360px;
            text-align: center;
            color: var(--accent-color);
            font-size: 14px;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <h2>Logo AI Studio Panel</h2>

    <div class="form-panel">
        <div class="form-group">
            <label>Brand (Kompaniya) Nomi</label>
            <input type="text" id="brand_name" placeholder="Masalan: GP COTTON, AUTO TUNING">
        </div>

        <div class="form-group">
            <label>Biznes Sohasi</label>
            <select id="industry">
                <option value="Luxury Corporate">🏢 Luxury & Premium Corporate</option>
                <option value="Automotive & Tuning">🚗 Avto va Tyuning Sohalari</option>
                <option value="Construction & Architecture">🏗️ Qurilish va Arxitektura</option>
                <option value="Fashion & Clothing">👕 Kiyim-kechak va Moda</option>
            </select>
        </div>

        <div class="form-group">
            <label>Uslub (Style)</label>
            <select id="style">
                <option value="3D Luxury Embossed">💎 3D Qabariq Metall</option>
                <option value="Minimalist Modern Flat">🎨 Minimalist Toza Flat</option>
                <option value="Monogram Emblem">🔤 Monogram Shriftli</option>
            </select>
        </div>

        <div class="form-group">
            <label>Asosiy Ranglar Palitrasi</label>
            <div class="color-palette">
                <div class="color-box selected" style="background: linear-gradient(to right, #000, #FFD700);" onclick="selectColor(this, 'Gold & Black')">Oltin</div>
                <div class="color-box" style="background: linear-gradient(to right, #111, #00FF7F);" onclick="selectColor(this, 'Neon Green')">Neon</div>
                <div class="color-box" style="background: linear-gradient(to right, #001133, #00B0FF);" onclick="selectColor(this, 'Cyber Blue')">Ko'k</div>
            </div>
        </div>
    </div>

    <button class="action-btn" id="generate_btn">LOGOTIPNI YARATISH</button>
    <div class="loader" id="loader_block">⚡ Telegramga yuborilmoqda...</div>

    <script>
        const tg = window.Telegram.WebApp;
        tg.expand();

        let selectedColorPalette = "Gold & Black";

        function selectColor(element, colorName) {
            document.querySelectorAll('.color-box').forEach(box => box.classList.remove('selected'));
            element.classList.add('selected');
            selectedColorPalette = colorName;
        }

        document.getElementById("generate_btn").addEventListener("click", () => {
            const name = document.getElementById("brand_name").value.trim();
            const ind = document.getElementById("industry").value;
            const st = document.getElementById("style").value;

            if(!name) {
                alert("Iltimos, brend nomini kiriting!");
                return;
            }

            document.getElementById("generate_btn").style.display = "none";
            document.getElementById("loader_block").style.display = "block";

            // Bot qabul qiladigan toza obyekt formati
            const payload = {
                brand_name: name,
                industry: ind,
                style: st,
                colors: selectedColorPalette
            };

            // Ma'lumotni Telegram botga uzatish
            setTimeout(() => {
                tg.sendData(JSON.stringify(payload));
                tg.close();
            }, 1000);
        });
    </script>
</body>
</html>
